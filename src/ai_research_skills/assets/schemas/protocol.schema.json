{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/signalridge/ai-research-skills/schemas/protocol.schema.json",
  "title": "Optional research protocol",
  "description": "An interoperable workspace record. All fields are optional so a researcher can use only the artifacts needed for a task; legacy phase fields remain readable.",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "topic": {"type": "string"},
    "question": {"type": "string"},
    "created": {"type": "string", "format": "date"},
    "last_searched_at": {"type": "string", "format": "date"},
    "search": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "not_attempted",
            "success",
            "success_no_hits",
            "partial_success",
            "backend_failure",
            "unknown"
          ]
        },
        "backend": {"type": "string", "minLength": 1},
        "queries": {"type": "array", "items": {"type": "string"}},
        "note": {"type": "string"}
      }
    },
    "phase": {"type": "integer", "minimum": 0, "maximum": 5},
    "scope": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "in": {"type": "array", "items": {"type": "string"}},
        "out": {"type": "array", "items": {"type": "string"}},
        "window": {"type": "string"},
        "venues": {"type": "array", "items": {"type": "string"}}
      }
    },
    "axes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "name": {"type": "string"},
          "values": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "recall_modes": {"type": "object", "additionalProperties": true},
    "screen": {"type": "object", "additionalProperties": true},
    "counts": {"type": "object", "additionalProperties": true},
    "saturation": {"type": "object", "additionalProperties": true},
    "budget": {"type": "object", "additionalProperties": true}
  }
}
