{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/signalridge/ai-research-skills/schemas/corpus.schema.json",
  "title": "Research corpus record",
  "description": "A flexible evidence record. Only a key is needed for interoperability; optional fields describe screening, extraction, provenance, and claims without implying a workflow phase.",
  "type": "object",
  "required": ["key"],
  "additionalProperties": true,
  "$defs": {
    "locator": {
      "type": "object",
      "required": ["kind", "value"],
      "additionalProperties": true,
      "properties": {
        "kind": {"type": "string", "minLength": 1},
        "value": {"type": "string", "minLength": 1},
        "detail": {"type": "string"}
      }
    }
  },
  "properties": {
    "key": {"type": "string", "minLength": 1},
    "id": {"type": "string"},
    "openalex_id": {"type": "string"},
    "title": {"type": "string"},
    "year": {"type": "integer", "minimum": 1, "maximum": 9999},
    "venue": {"type": "string"},
    "found_via": {"type": "array", "items": {"type": "string"}},
    "relevance": {"type": "integer", "minimum": 1, "maximum": 10},
    "contextual_summary": {"type": "string"},
    "screen": {"enum": ["include", "exclude", "unsure"]},
    "exclude_reason": {"type": ["string", "null"]},
    "code": {"type": "object", "additionalProperties": true},
    "axes": {"type": "object", "additionalProperties": true},
    "claim": {"type": "string"},
    "claim_locator": {"$ref": "#/$defs/locator"},
    "corroboration": {"type": "object", "additionalProperties": true},
    "numbers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "locator": {"$ref": "#/$defs/locator"}
        }
      }
    },
    "evidence_read": {"type": "string"},
    "accessed": {"type": "string", "format": "date"},
    "notes_path": {"type": "string"}
  }
}
