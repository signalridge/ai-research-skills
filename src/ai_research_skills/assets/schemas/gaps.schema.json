{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/signalridge/ai-research-skills/schemas/gaps.schema.json",
  "title": "Research gaps",
  "description": "Optional evidence notes and candidate gaps. They may be incomplete while a researcher is exploring; the linter checks supplied structure and references only.",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id"],
        "additionalProperties": true,
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "statement": {"type": "string"},
          "type": {"type": "string"},
          "evidence_of_absence": {"type": "object", "additionalProperties": true},
          "confidence": {"type": "string"},
          "closes_if": {"type": "string"},
          "closes_if_met": {"type": "object", "additionalProperties": true},
          "threats": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
          "verdict": {"type": "object", "additionalProperties": true}
        }
      }
    }
  }
}
