{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/signalridge/ai-research-skills/schemas/coverage.schema.json",
  "title": "Optional coverage notes",
  "description": "A flexible map for interoperability. Empty cells and partial maps are valid; completeness is a research choice, not a linter gate.",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "axes": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
    "cells": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "coords": {"type": "object", "additionalProperties": true},
          "occupants": {"type": "array", "items": {"type": "string"}},
          "state": {"type": "string"},
          "trend_evidence": {"type": "string"},
          "gap_id": {"type": "string"},
          "revivable_by": {"type": ["string", "null"]}
        }
      }
    },
    "recall_diagnostic": {"type": "object", "additionalProperties": true}
  }
}
