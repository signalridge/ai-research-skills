{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/signalridge/research-skills/schemas/protocol.schema.json",
  "title": "Search protocol",
  "description": "The reproducible search contract. `watch` is nothing more than re-running this file.",
  "type": "object",
  "required": [
    "topic",
    "question",
    "created",
    "last_searched_at",
    "scope",
    "recall_modes",
    "screen"
  ],
  "additionalProperties": false,
  "properties": {
    "topic": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "question": {
      "type": "string",
      "minLength": 20,
      "description": "One interrogative sentence. If it does not end in '?', it is a topic, not a question."
    },
    "created": {
      "type": "string",
      "format": "date"
    },
    "last_searched_at": {
      "type": "string",
      "format": "date",
      "description": "Read by the staleness hook. In a field tripling annually a six-week-old survey is a liability."
    },
    "phase": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5,
      "description": "Highest completed phase. `survey` resumes from here."
    },
    "scope": {
      "type": "object",
      "required": [
        "in",
        "out"
      ],
      "additionalProperties": false,
      "properties": {
        "in": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "out": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "window": {
          "type": "string",
          "description": "e.g. 2023-01-01.."
        },
        "venues": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "axes": {
      "type": "array",
      "minItems": 2,
      "description": "Taxonomy axes, DECLARED IN PHASE 0 BEFORE SEARCHING. A post-hoc taxonomy describes your sample, not the field, and manufactures fake empty cells.",
      "items": {
        "type": "object",
        "required": [
          "name",
          "values"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "values": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 2
          }
        }
      }
    },
    "recall_modes": {
      "type": "object",
      "required": [
        "keyword",
        "citation_chain",
        "venue_author"
      ],
      "additionalProperties": false,
      "description": "All three are mandatory. Keyword-only search has poor recall in CS/ML because terminology drifts faster than it standardises.",
      "properties": {
        "keyword": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object"
          }
        },
        "citation_chain": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object"
          }
        },
        "venue_author": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object"
          }
        }
      }
    },
    "screen": {
      "type": "object",
      "required": [
        "include",
        "exclude",
        "relevance_threshold"
      ],
      "additionalProperties": false,
      "properties": {
        "include": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "relevance_threshold": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "retrieved": {
          "type": "integer",
          "minimum": 0
        },
        "deduped": {
          "type": "integer",
          "minimum": 0
        },
        "adjudicated": {
          "type": "integer",
          "minimum": 0,
          "description": "Coverage. A survey that judged 40 of 200 candidates and one that judged all 200 must not look identical."
        },
        "scored_at_or_above_threshold": {
          "type": "integer",
          "minimum": 0
        },
        "unsure": {
          "type": "integer",
          "minimum": 0
        },
        "fulltext_kept": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "saturation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rounds": {
          "type": "integer",
          "minimum": 1
        },
        "new_on_topic_last_round": {
          "type": "integer",
          "minimum": 0
        },
        "baseline_growth": {
          "type": "string",
          "description": "Field growth rate from openalex_analyze_trends. In a field growing 3x/yr, '<5% new this round' is stasis, not saturation."
        },
        "stop_rule": {
          "type": "string"
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "openalex_usd_spent": {
          "type": "number",
          "minimum": 0
        },
        "openalex_usd_remaining": {
          "type": "number",
          "minimum": 0
        }
      }
    }
  }
}
