# Survey state belongs to the project being surveyed, not to this repo — but only at
# the repo root. examples/ and tests/fixtures/ carry .research/ trees on purpose.
/.research/

# .claude/{skills,commands,hooks} are the product and are tracked. settings.json is
# generated per-install by `research-skills install`, so it is not — installing into
# this checkout to dogfood the guards should not show up as a diff.
.claude/settings.json
# Generated by `research-skills install` into this checkout when dogfooding: a copy of
# scripts/rs_validate.py and schemas/. The originals are the tracked source.
.claude/research-skills/

# Python
__pycache__/
.ruff_cache/
*.py[cod]
.venv/
venv/

# Packaging
dist/
*.egg-info/

# uv.lock is COMMITTED on purpose: it pins ruff and basedpyright, and their
# versions decide whether lint and typecheck pass. A floating toolchain means CI
# and your laptop can disagree about whether the code is clean.

# macOS
.DS_Store

# Editors
.idea/
*.swp
