# Survey state belongs to the project being surveyed, not to this repo — but only at
# the repo root. examples/ and tests/fixtures/ carry .research/ trees on purpose.
/.research/

# The product's source of truth is src/ai_research_skills/assets/. Everything under .claude/ here
# is output from `ai-research-skills install .` — the way this repo dogfoods its own
# skills — so none of it is tracked. `just sync` regenerates it after a fresh clone.
/.claude/

# Installer ownership and transaction metadata are generated project state, not source.
/.ai-research-skills/

# Python
__pycache__/
.ruff_cache/
*.py[cod]
.venv/
venv/

# Packaging
dist/
*.egg-info/

# uv.lock is COMMITTED on purpose: it pins ruff and basedpyright, and their
# versions decide whether lint and typecheck pass. A floating toolchain means CI
# and your laptop can disagree about whether the code is clean.

# macOS
.DS_Store

# Editors
.idea/
*.swp
